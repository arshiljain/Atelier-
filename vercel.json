{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/_next/image",
      "destination": "/api/image"
    },
    {
      "source": "/images/:path*",
      "destination": "/api/image"
    },
    {
      "source": "/_next/static/:path*",
      "destination": "/api/static?path=:path*"
    },
    {
      "source": "/_vercel/:path*",
      "destination": "/api/static"
    },
    {
      "source": "/api/:match*",
      "destination": "/api/[...path]"
    },
    {
      "source": "/blocks/:slug*",
      "destination": "/blocks.html"
    },
    {
      "source": "/templates/:slug*",
      "destination": "/templates.html"
    },
    {
      "source": "/@:handle",
      "destination": "/_:handle.html"
    },
    {
      "source": "/profile/:handle",
      "destination": "/_:handle.html"
    },
    {
      "source": "/justified-studio",
      "destination": "/_justified-studio.html"
    },
    {
      "source": "/ilovecreatives",
      "destination": "/_ilovecreatives.html"
    },
    {
      "source": "/kiel-d-m",
      "destination": "/_kiel-d-m.html"
    },
    {
      "source": "/clemensmako",
      "destination": "/_clemensmako.html"
    },
    {
      "source": "/letsavee",
      "destination": "/_letsavee.html"
    },
    {
      "source": "/melivan-colas",
      "destination": "/_melivan-colas.html"
    },
    {
      "source": "/studio-kiln",
      "destination": "/_studio-kiln.html"
    },
    {
      "source": "/studio-size",
      "destination": "/_studio-size.html"
    },
    {
      "source": "/thebrandidentity",
      "destination": "/_thebrandidentity.html"
    }
  ],
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        {
          "key": "Accept-Ranges",
          "value": "bytes"
        }
      ]
    }
  ]
}
